{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plata",
  "version": "3.0.420",
  "identifier": "net.plataapp.desktop",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Plata", "width": 1280, "height": 820, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Plata",
    "copyright": "Plata",
    "shortDescription": "Finanzas simples. Tu plata a tu modo.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Spanish", "English"] }
    }
  }
}
